{
  "name": "ai-loan-agent",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @ai-loan-agent/web dev",
    "mock": "pnpm --filter @ai-loan-agent/web mock",
    "build": "pnpm --filter @ai-loan-agent/web build",
    "start": "pnpm --filter @ai-loan-agent/web start",
    "typecheck": "pnpm --filter @ai-loan-agent/web typecheck",
    "test": "pnpm demo:test && pnpm --filter @ai-loan-agent/web test",
    "demo:dev": "vite",
    "demo:build": "tsc --noEmit && vite build",
    "demo:typecheck": "tsc --noEmit",
    "demo:test": "vitest run --dir ./src",
    "e2e": "pnpm --filter @ai-loan-agent/web e2e",
    "worker": "pnpm --filter @ai-loan-agent/web worker"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.44.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
